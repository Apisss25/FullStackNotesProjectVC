NotesProjectBackend/auth.json
NotesProjectBackend/Homestead.json
NotesProjectBackend/Homestead.yaml
NotesProjectBackend/homestead.local.yml
NotesProjectBackend/.flake8
NotesProjectBackend/.flight
NotesProjectBackend/.idea
NotesProjectBackend/.vscode

# OS / IDE
.DS_Store
*.swp
*.swo
*.log
.env.local

# Monorepo root
/.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# -----------------------------------
# Combined ignore for both folders (literal paths)
