# Frontend (notesprojectvc/)
notesprojectvc/node_modules
notesprojectvc/.next
notesprojectvc/out
notesprojectvc/.env*
notesprojectvc/.pnp
notesprojectvc/.pnp.*
notesprojectvc/coverage
notesprojectvc/.DS_Store

# Backend (NotesProjectBackend/)
NotesProjectBackend/vendor
NotesProjectBackend/.env
NotesProjectBackend/.env.*
